{
  "name": "molva-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Electron-оболочка molva: рендер состояния ядра и медиастек",
  "author": "udison <udison.myself@gmail.com>",
  "homepage": "https://github.com/udisondev/molva",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "prestart": "go -C .. build -o molvad ./cmd/molvad",
    "build": "tsc -p tsconfig.json --noEmit && vite build && npm run build:electron",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --outdir=dist-electron --format=cjs",
    "start": "npm run build && electron .",
    "gen": "cd .. && sh proto/gen.sh",
    "dist": "npm run build && node scripts/build-daemon.mjs && electron-builder --config electron-builder.json"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.0",
    "ts-proto": "^2.7.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.5.2",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "allowScripts": {
    "electron@42.4.0": true,
    "esbuild@0.28.0": true
  }
}
